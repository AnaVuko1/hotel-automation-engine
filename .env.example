# Database
DATABASE_URL=sqlite+aiosqlite:///./data/hotel.db

# Security
SECRET_KEY=change-this-to-a-random-secret-in-production

# Redis (optional, for agent state persistence)
REDIS_URL=redis://redis:6379/0

# Hotel Configuration
HOTEL_NAME=Grand Horizon Hotel
HOTEL_ADDRESS=123 Ocean Boulevard, Miami, FL 33139
HOTEL_PHONE=+1-305-555-0123
HOTEL_EMAIL=info@grandhorizonhotel.com
HOTEL_DESCRIPTION=A luxurious beachfront hotel with stunning ocean views and premium amenities.

# Pricing Configuration
OTA_COMMISSION_RATE=0.18
BASE_PRICE_STANDARD=120
BASE_PRICE_DELUXE=195
BASE_PRICE_SUITE=310

# Agent Configuration
GUEST_AGENT_ENABLED=true
OPS_AGENT_ENABLED=true
HSK_AGENT_ENABLED=true
REVENUE_AGENT_ENABLED=true

# Escalation
ESCALATION_EMAIL=manager@grandhorizonhotel.com
ESCALATION_PHONE=+1-305-555-0199
